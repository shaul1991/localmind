[Unit]
Description=localmind MCP server (HTTP transport, Tailscale-bound)
Documentation=https://github.com/shaul1991/localmind
After=network-online.target tailscaled.service docker.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=localmind
Group=localmind
WorkingDirectory=/opt/localmind/current
EnvironmentFile=/etc/localmind/localmind.env
ExecStart=/usr/bin/node /opt/localmind/current/dist/mcp.js
Restart=always
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.localmind /root/personal/shaul-brain/second-brain-shared /root/personal/shaul-brain/second-brain-private
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
